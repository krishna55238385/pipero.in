# =============================================================================
# Single project-wide environment file (template).
# Copy to .env at the repo root and fill in your values.
# Read by phase1, phase2, and phase3 — run any phase from the repo root,
# e.g. `python -m phase1 run-all`.
# =============================================================================

# --- Shared across all phases (required) --------------------------------------
OPENAI_API_KEY=sk-proj-...
# LLM model used by every phase — the ONLY place a model name is configured.
OPENAI_MODEL=gpt-4o-mini
# Per-1M-token USD prices for OPENAI_MODEL (cost reporting only).
OPENAI_INPUT_COST_PER_1M=0.15
OPENAI_OUTPUT_COST_PER_1M=0.60
SERP_API_KEY=...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_...
# Optional: fallback for email-pattern discovery in Agent 02
HUNTER_API_KEY=

# --- Phase 3: Agent 14 sending — option A: Instantly (hand-off) ---------------
INSTANTLY_API_KEY=

# --- Phase 3: Agent 14 sending — option B: direct Gmail (the n8n approach) ----
# App password (16 chars) from https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Public base URL of phase3/tracking_server.py (open pixel + unsubscribe).
# Leave blank to send without tracking. For local testing use an ngrok URL.
TRACKING_BASE_URL=

# Footer brand + reputation guardrails for the gmail sender
EMAIL_BRAND_NAME=AI GTM Agency
DAILY_SEND_CAP=50
SEND_THROTTLE_MIN_SECONDS=0
SEND_THROTTLE_MAX_SECONDS=0

# --- gtm_service scheduler / CRM integration -----------------------------------
# Base URL of the pipero.in CRM; the scheduler pings {CRM_BASE_URL}/api/engage/worker
# every 60s so queued campaign emails go out. Leave blank to skip the ping.
CRM_BASE_URL=http://localhost:3000
# Shared secret for that worker endpoint (must match ENGAGE_WORKER_TOKEN in
# pipero.in/.env.local). Generate with: openssl rand -hex 16
ENGAGE_WORKER_TOKEN=
# Master switch for the gtm_service background scheduler loop (default: true).
SCHEDULER_ENABLED=true
