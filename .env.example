# =============================================================================
# Single project-wide environment file (template).
# Copy to .env at the repo root and fill in your values.
# Read by the gtm_backend GTM pipeline (phase1/2/3) — run from the repo root,
# e.g. `python -m gtm_backend find-all` (or `python -m gtm_backend.phase1 run-all`).
# =============================================================================

# --- Phase 1: Gemini (Agents 01-05) --------------------------------------------
GEMINI_API_KEY=AIza...
# LLM model used by Phase 1 only — the ONLY place a Phase-1 model name is configured.
GEMINI_MODEL=gemini-2.5-flash
# Per-1M-token USD prices for GEMINI_MODEL (cost reporting only).
GEMINI_INPUT_COST_PER_1M=0.30
GEMINI_OUTPUT_COST_PER_1M=2.50

# --- Shared across phase2 + phase3 (required) ----------------------------------
OPENAI_API_KEY=sk-proj-...
# LLM model used by phase2/phase3 — the ONLY place a model name is configured for them.
OPENAI_MODEL=gpt-4o-mini
# Per-1M-token USD prices for OPENAI_MODEL (cost reporting only).
OPENAI_INPUT_COST_PER_1M=0.15
OPENAI_OUTPUT_COST_PER_1M=0.60

# --- Shared across all phases (required) --------------------------------------
SERP_API_KEY=...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_...
# Optional: fallback for email-pattern discovery in Agent 02
HUNTER_API_KEY=

# --- Phase 3: Agent 14 sending — option A: Instantly (hand-off) ---------------
INSTANTLY_API_KEY=

# --- Phase 3: Agent 14 sending — option B: direct Gmail (the n8n approach) ----
# App password (16 chars) from https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Public base URL of phase3/tracking_server.py (open pixel + unsubscribe).
# Leave blank to send without tracking. For local testing use an ngrok URL.
TRACKING_BASE_URL=

# Footer brand + reputation guardrails for the gmail sender
EMAIL_BRAND_NAME=AI GTM Agency
DAILY_SEND_CAP=50
SEND_THROTTLE_MIN_SECONDS=0
SEND_THROTTLE_MAX_SECONDS=0

# --- gtm_service scheduler / CRM integration -----------------------------------
# Base URL of the Magnivo AI CRM; the scheduler pings {CRM_BASE_URL}/api/engage/worker
# every 60s so queued campaign emails go out. Leave blank to skip the ping.
CRM_BASE_URL=http://localhost:3000
# Shared secret for that worker endpoint (must match ENGAGE_WORKER_TOKEN in
# magnivo.ai/.env.local). Generate with: openssl rand -hex 16
ENGAGE_WORKER_TOKEN=
# Master switch for the gtm_service background scheduler loop (default: true).
SCHEDULER_ENABLED=true

# --- GA4 anonymous website-visitor ingest (Prospects → Visitors) ---------------
# Lets gtm_service pull Google Analytics 4 data via the Analytics Data API and
# write website_visitor_signals. Requires a Google service account that has the
# "Google Analytics Data API" enabled and is granted Viewer on your GA4 property.
# Provide the key EITHER as a file path (recommended) OR inline as one-line JSON.
GA4_SA_FILE=                # absolute path to the service-account .json key
# GA4_SA_JSON=              # alternative: the service-account JSON on a single line
# Optional — only for reverse-IP company identification (RB2B/Clearbit/Vector):
# the GA4 custom-dimension API name that carries the visiting company. Leave blank
# for standard GA4 (aggregate intent: landing pages, channels, country, scores).
# GA4_COMPANY_DIMENSION=
